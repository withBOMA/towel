# Copy to .env.local and fill in. `supabase status` prints the local values.

# Supabase project (local: http://127.0.0.1:55321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Publishable key (starts with sb_publishable_). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of this app (used in sign-in and invite links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Product name shown in the UI 
NEXT_PUBLIC_APP_NAME=Towelapp

# Optional: send invite emails through Resend. Leave blank to copy invite links by hand.
RESEND_API_KEY=
EMAIL_FROM="Towelapp <no-reply@yourdomain.ca>"
